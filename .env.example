LLM_PROVIDER=openai
OPENAI_API_KEY=
# OpenRouter uses its OpenAI-compatible API and server-side web-search tool.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Keep requests below typical key-level credit limits; increase only when funded.
OPENROUTER_MAX_TOKENS=1000
# Optional when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional enrichment
APOLLO_API_KEY=
HUNTER_API_KEY=
# Optional search fallback; OpenAI uses its built-in web search by default.
TAVILY_API_KEY=
SERPER_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-4-20250514
